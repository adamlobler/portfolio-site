# Generated by `yarn tokens`. Prettier and the emitters would fight over these
# forever, and the emitters win: this output is written to be *read* as a build
# artefact — column-aligned, grouped by axis block, with its own banner.
styles/tokens/
tokens/generated/

# The authored token JSON. Hand-aligned on purpose: `$value` columns line up so
# a reviewer can read a whole theme's palette down one column, which is exactly
# what Prettier would undo.
tokens/**/*.json

