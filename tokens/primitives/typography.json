{
  "prim": {
    "font": {
      "family": {
        "$type": "fontFamily",
        "$description": "Raw stacks. Expression semantics choose which stack a theme speaks in.",
        "sans": {
          "$value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif"
        },
        "serif": {
          "$value": "ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif"
        },
        "mono": {
          "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace"
        }
      },
      "size": {
        "$type": "dimension",
        "$description": "Raw type sizes, in px, ported 1:1 from the pre-token Tailwind fontSize scale.",
        "10": { "$value": "10px" },
        "12": { "$value": "12px" },
        "14": { "$value": "14px" },
        "18": { "$value": "18px" },
        "20": { "$value": "20px" },
        "24": { "$value": "24px" },
        "34": { "$value": "34px" },
        "38": { "$value": "38px" },
        "40": { "$value": "40px" },
        "48": { "$value": "48px" },
        "84": { "$value": "84px" }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": "400" },
        "medium": { "$value": "500" },
        "semibold": { "$value": "600" },
        "bold": { "$value": "700" },
        "black": { "$value": "900" }
      },
      "leading": {
        "$type": "number",
        "$description": "Raw line heights. The `rem` entries are ported verbatim from the pre-token scale.",
        "tight": { "$value": "1.2" },
        "snug": { "$value": "1.35" },
        "normal": { "$value": "1.5" },
        "relaxed": { "$value": "1.7" },
        "rem-1": { "$value": "1rem" },
        "rem-1-2": { "$value": "1.2rem" },
        "rem-1-25": { "$value": "1.25rem" },
        "rem-1-5": { "$value": "1.5rem" },
        "rem-1-7": { "$value": "1.7rem" },
        "rem-1-75": { "$value": "1.75rem" },
        "rem-1-8": { "$value": "1.8rem" },
        "rem-2": { "$value": "2rem" }
      },
      "tracking": {
        "$type": "dimension",
        "$description": "Raw letter-spacing. Expression semantics decide how tight a theme sets.",
        "tighter": { "$value": "-0.02em" },
        "tight": { "$value": "-0.01em" },
        "none": { "$value": "0em" },
        "wide": { "$value": "0.3px" },
        "wider": { "$value": "0.4px" },
        "widest": { "$value": "0.12em" }
      }
    }
  }
}
