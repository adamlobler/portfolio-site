{
  "semExpr": {
    "glass": {
      "$description": "Expression semantics for `glass`. The only theme that sets a non-zero backdrop blur; shadows carry an inset highlight.",
      "radius": {
        "$type": "dimension",
        "control": {
          "$value": "{prim.radius.lg}"
        },
        "card": {
          "$value": "{prim.radius.2xl}"
        },
        "pill": {
          "$value": "{prim.radius.full}"
        }
      },
      "stroke": {
        "$type": "dimension",
        "width-hairline": {
          "$value": "{prim.stroke.hairline}"
        },
        "width-emphasis": {
          "$value": "{prim.stroke.hairline}"
        },
        "style": {
          "$value": "{prim.stroke-style.solid}",
          "$type": "strokeStyle"
        }
      },
      "shadow": {
        "$type": "shadow",
        "flat": {
          "$value": "{prim.shadow.none}"
        },
        "raised": {
          "$value": "{prim.shadow.glass-md}"
        },
        "overlay": {
          "$value": "{prim.shadow.glass-lg}"
        },
        "focus": {
          "$value": "{prim.shadow.soft-sm}"
        }
      },
      "font": {
        "$type": "fontFamily",
        "display": {
          "$value": "{prim.font.family.sans}"
        },
        "body": {
          "$value": "{prim.font.family.sans}"
        },
        "mono": {
          "$value": "{prim.font.family.mono}"
        }
      },
      "weight": {
        "$type": "fontWeight",
        "display": {
          "$value": "{prim.font.weight.semibold}"
        },
        "body": {
          "$value": "{prim.font.weight.regular}"
        },
        "emphasis": {
          "$value": "{prim.font.weight.medium}"
        },
        "strong": {
          "$value": "{prim.font.weight.medium}"
        }
      },
      "tracking": {
        "$type": "dimension",
        "display": {
          "$value": "{prim.font.tracking.tight}"
        },
        "body": {
          "$value": "{prim.font.tracking.wide}"
        },
        "caps": {
          "$value": "{prim.font.tracking.widest}"
        }
      },
      "material": {
        "$type": "dimension",
        "blur": {
          "$value": "{prim.blur.lg}"
        }
      }
    }
  }
}
